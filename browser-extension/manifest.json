{
  "manifest_version": 3,
  "name": "Usage Monitor - Claude使用率連携",
  "version": "0.1.0",
  "description": "Claude使用状況ページの使用率とリセット時刻をローカルのUsage Monitorへ渡します。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/new*",
    "https://claude.ai/settings/usage*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Claude使用状況を開いて連携"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/new*",
        "https://claude.ai/settings/usage*"
      ],
      "js": [
        "parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
